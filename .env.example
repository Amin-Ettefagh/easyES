# ---------------------------------------------------------------------------
# easyES — environment template.
#
# Copy to `.env` next to docker-compose.yml and adjust. Every variable has a
# sane default, so an empty `.env` (or no `.env` at all) works for the demo.
# The only required changes for real use are marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
# REQUIRED in production: a long random string (Django secret).
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Field-level encryption passphrase for stored credentials (API keys etc.).
# Fernet keys are derived from this; the dev default is NOT secure.
EASYES_ENCRYPTION_KEY=dev-demo-encryption-passphrase

# Workspace root (host path). Defaults to ./data/workspaces next to the repo.
EASYES_WORKSPACES_ROOT=./data/workspaces

# Demo seed + login (amin / 123456). OFF in production.
EASYES_ALLOW_DEMO_SEED=1
EASYES_SEED=1
# Set to 1 to also run one workflow end-to-end on container boot.
EASYES_RUN_DEMO=0
# success | fail_once | always_fail
EASYES_DEMO_SCENARIO=fail_once

# Execution backend: thread (in-process, demo) | inline (tests/CLI).
EASYES_EXECUTION_BACKEND=thread
# Default model provider when an agent does not pin one: fake (offline demo).
EASYES_DEFAULT_PROVIDER=fake

# --- Frontend --------------------------------------------------------------
# Free host ports selected for this workspace. Change both the port and the
# matching URL/origins together, then rebuild the frontend image.
BACKEND_PORT=18120
FRONTEND_PORT=18121
CORS_ALLOWED_ORIGINS=http://localhost:18121,http://127.0.0.1:18121
CSRF_TRUSTED_ORIGINS=http://localhost:18121,http://127.0.0.1:18121

# Host-reachable backend URL, baked into the browser bundle at build time.
# If you change the backend port or host, rebuild the frontend image.
NEXT_PUBLIC_API_BASE=/api/v1
INTERNAL_API_BASE=http://backend:8000/api/v1

# --- Postgres --------------------------------------------------------------
# These are baked into docker-compose.yml; the db service is not published to
# the host, so defaults only need changing in hardened deployments.
POSTGRES_DB=easyes
POSTGRES_USER=easyes
POSTGRES_PASSWORD=easyes
